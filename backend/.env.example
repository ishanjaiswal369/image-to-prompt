# Postgres connection (matches docker-compose.yml service by default)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/image_to_prompt?schema=public"

# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Extension origin allowed by CORS, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
EXTENSION_ORIGIN="chrome-extension://REPLACE_WITH_EXTENSION_ID"

# Auth
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID"
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_RANDOM_SECRET"
JWT_REFRESH_TTL="30d"

# Vision provider — "gemini" or "openrouter"
VISION_PROVIDER="gemini"
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-latest"

# Only needed if VISION_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys.
# Default model is a free, general-purpose vision-language model (verified working
# as of testing — see docs/ARCHITECTURE.md for how free-model availability was checked).
OPENROUTER_API_KEY="REPLACE_WITH_OPENROUTER_API_KEY"
OPENROUTER_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# Credits
SIGNUP_BONUS_CREDITS=20

# Admin (dev-only credit grant endpoint — stand-in for a future payment webhook)
ADMIN_TOKEN="REPLACE_WITH_ADMIN_TOKEN"

# Rate limiting
RATE_LIMIT_PER_USER_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=200
