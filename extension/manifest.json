{
  "manifest_version": 3,
  "name": "Image to Prompt",
  "version": "0.1.0",
  "description": "Right-click any image, or select a screen region, to get a structured text-to-image prompt.",
  "permissions": ["contextMenus", "storage", "activeTab", "identity", "scripting"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Image to Prompt",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "oauth2": {
    "client_id": "441916701308-3p2g19q7p7bini4t5igelu0eql7a905g.apps.googleusercontent.com",
    "scopes": ["openid", "email"]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/floatingcard/index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "116"
}
